# --- Postgres ---
POSTGRES_USER=canopy
POSTGRES_PASSWORD=canopy
POSTGRES_DB=canopy

# --- Backend ---
# For local (non-docker) dev, point at localhost; compose overrides these.
# Production runs on Postgres or MySQL/MariaDB (SQLite is dev/local only).
DATABASE_URL=postgresql+asyncpg://canopy:canopy@localhost:5432/canopy
#   MySQL/MariaDB (needs the optional driver: pip install -e "backend/.[mysql]"):
#   DATABASE_URL=mysql+aiomysql://canopy:canopy@localhost:3306/canopy
#   SQLite (dev/local only):
#   DATABASE_URL=sqlite+aiosqlite:///./canopy.db
REDIS_URL=redis://localhost:6379/0

# JWT auth
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Fernet key used to encrypt connector tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# First superuser seeded on startup (optional)
FIRST_SUPERUSER_EMAIL=architect@example.com
FIRST_SUPERUSER_PASSWORD=changeme

# Demo / seeded-data mode (LOCAL & DEV ONLY — never enable in production).
# When true, an admin can load/reset a full demo dataset from the UI (Admin → Demo data),
# the login screen lists demo accounts, and Jira/GitHub/Drive connectors are served by an
# in-process mock so the whole app works offline without real credentials.
DEMO_MODE=false
# Which seed narrative demo mode loads by default: helix | agentic
DEMO_DATASET=helix

# CORS (comma-separated origins for the React dev server)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Claude MCP server (plugin) ---
# Read by plugin/mcp_server. stdio (default) for a locally-installed plugin; http
# (streamable HTTP, the modern MCP transport) for a long-lived production service.
CANOPY_API_BASE_URL=http://localhost:8000
CANOPY_API_TOKEN=
# Service-account alternative to a static token: the MCP server logs in as this canopy
# user and refreshes its own JWT (recommended in production — tokens expire).
CANOPY_API_EMAIL=
CANOPY_API_PASSWORD=
# CANOPY_MCP_TRANSPORT=http       # stdio (default) | http | sse (legacy)
# CANOPY_MCP_HOST=0.0.0.0
# CANOPY_MCP_PORT=8765
# CANOPY_MCP_PATH=/mcp
# Shared secret Claude must send as "Authorization: Bearer …" to reach the MCP
# endpoint. REQUIRED by compose.prod.yml (the endpoint is public behind ngrok).
CANOPY_MCP_AUTH_TOKEN=

# --- Production front door (compose.prod.yml: Caddy + optional ngrok) ---
# See docs/PRODUCTION.md for the full setup guide.
# The public URL users/Claude/webhooks reach the stack on (the ngrok URL or your domain).
# Drives OAuth redirects + links back into the app.
PUBLIC_BASE_URL=http://localhost
# Serve a real domain on :443 with Let's Encrypt: set both (leave unset for LAN/self-signed).
CANOPY_DOMAIN=
CANOPY_TLS=internal
# ngrok tunnel (docker compose -f compose.prod.yml --profile ngrok up -d):
NGROK_AUTHTOKEN=
# NGROK_DOMAIN=your-reserved-name.ngrok.app

# --- Webhook secrets ---
# HMAC secrets for POST /webhooks/github, /webhooks/jira and /webhooks/events (CI/observability
# events). Signature verification is SKIPPED while a secret is empty, so set all three on any
# internet-reachable deployment (e.g. `openssl rand -hex 32`).
GITHUB_WEBHOOK_SECRET=
JIRA_WEBHOOK_SECRET=
EVENTS_WEBHOOK_SECRET=

# --- OAuth 2.0 (3LO) ---
# Where providers redirect after consent (must match the OAuth app registration):
#   <OAUTH_REDIRECT_BASE_URL>/api/v1/connectors/oauth/callback
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
# Register apps at: Atlassian developer console, GitHub OAuth Apps, Google Cloud console.
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- File-drop ingest (optional) ---
# Watched shared storage canopy polls for JSON/CSV export files to ingest, layout
# <root>/<connection_id>/*.{json,csv}. Leave FILE_DROP_BACKEND empty to disable the poll
# (the /ingest/file upload endpoint still works). S3 needs the [s3] extra: pip install -e ".[s3]"
FILE_DROP_BACKEND=            # "" (disabled) | local | s3
FILE_DROP_LOCAL_DIR=         # e.g. /var/canopy/drops  (when FILE_DROP_BACKEND=local)
FILE_DROP_S3_BUCKET=         # when FILE_DROP_BACKEND=s3 (uses the standard AWS credential chain)
FILE_DROP_S3_PREFIX=canopy-drops
FILE_DROP_POLL_MINUTES=10

# --- Plugin / MCP setup instructions (Agent Setup page, optional) ---
# Override these on a fork or self-hosted deployment so the copy-paste snippets on the Agent
# Setup page point at YOUR repo/marketplace instead of the upstream default. Served (non-secret)
# via GET /api/v1/meta.
PLUGIN_MARKETPLACE_REF=harshendu/canopy                       # `/plugin marketplace add <ref>`
PLUGIN_REPO_URL=https://github.com/harshendu/canopy.git       # MCP-only clone URL
PLUGIN_MCP_SERVER_PATH=plugin/mcp_server/server.py            # server path within the clone
