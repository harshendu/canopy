# --- Postgres ---
POSTGRES_USER=canopy
POSTGRES_PASSWORD=canopy
POSTGRES_DB=canopy

# --- Backend ---
# For local (non-docker) dev, point at localhost; compose overrides these.
DATABASE_URL=postgresql+asyncpg://canopy:canopy@localhost:5432/canopy
REDIS_URL=redis://localhost:6379/0

# JWT auth
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Fernet key used to encrypt connector tokens at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# First superuser seeded on startup (optional)
FIRST_SUPERUSER_EMAIL=architect@example.com
FIRST_SUPERUSER_PASSWORD=changeme

# CORS (comma-separated origins for the React dev server)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Connector webhook secrets (optional until configured) ---
GITHUB_WEBHOOK_SECRET=
JIRA_WEBHOOK_SECRET=

# --- OAuth 2.0 (3LO) ---
# Where providers redirect after consent (must match the OAuth app registration):
#   <OAUTH_REDIRECT_BASE_URL>/api/v1/connectors/oauth/callback
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
# Register apps at: Atlassian developer console, GitHub OAuth Apps, Google Cloud console.
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
